{
  "name": "mju-public-data-worker",
  "version": "1.0.0",
  "description": "명지클로 공통 정보 수집 worker",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit",
    "migrate": "tsx src/main.ts migrate",
    "doctor": "tsx src/main.ts doctor",
    "check:course-catalog-env": "node scripts/check-course-catalog-env.mjs",
    "check:course-catalog-import-env": "node scripts/check-course-catalog-env.mjs --require-db",
    "benchmark:cafeteria-ocr": "tsx src/cafeterias/ocr-benchmark.ts",
    "collect:cafeterias": "tsx src/main.ts collect cafeterias",
    "collect:cafeteria-official-pages": "tsx src/main.ts collect cafeteria-official-pages",
    "collect:course-catalog": "tsx src/main.ts collect course-catalog",
    "collect:course-catalog:msi-department-timetable": "tsx src/main.ts collect course-catalog --from-mju-cli-department-timetable",
    "collect:course-catalog:msi-timetable": "tsx src/main.ts collect course-catalog --from-mju-cli-timetable",
    "collect:graduation-requirements": "tsx src/main.ts collect graduation-requirements",
    "seed:import-release": "node scripts/import-seeds-from-release.mjs",
    "export:course-catalog:msi-department-timetable": "tsx src/main.ts export course-catalog --from-mju-cli-department-timetable",
    "export:course-catalog:msi-timetable": "tsx src/main.ts export course-catalog --from-mju-cli-timetable",
    "collect:notices": "tsx src/main.ts collect notices",
    "schedule:tick": "tsx src/main.ts schedule tick",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "myongji",
    "worker",
    "scraper",
    "postgres"
  ],
  "author": "nullhyeon <wnsgus7832@gmail.com>",
  "license": "ISC",
  "dependencies": {
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.3",
    "got": "^14.6.3",
    "jimp": "^1.6.0",
    "jszip": "^3.10.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
