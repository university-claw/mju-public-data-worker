PGHOST=localhost
PGPORT=5432
PGDATABASE=mjuclaw
PGUSER=mjuclaw_app
PGPASSWORD=change-me
PGSCHEMA=public_data
STORAGE_PROVIDER=local
# Windows 예시: C:\Users\your-name\Desktop\mjuclaw-data\assets
STORAGE_LOCAL_ROOT=/absolute/path/to/mjuclaw-data/assets
OCR_LANGUAGES=kor+eng
# Cafeteria OCR defaults to PaddleOCR. The Docker image includes these deps.
CAFETERIA_OCR_COMMAND=python scripts/cafeteria_paddleocr_candidate.py {image}
PADDLE_OCR_REC_MODEL_NAME=korean_PP-OCRv5_mobile_rec
# Docker scheduler loop options.
# PUBLIC_DATA_WORKER_TICK_INTERVAL_SECONDS=600
# PUBLIC_DATA_WORKER_RUN_MIGRATIONS=1

# 공지 normalization(OpenAI) 설정
# OPENAI_API_KEY가 있고 NOTICE_NORMALIZATION_ENABLED를 비워두면 normalization이 자동으로 켜집니다.
# NOTICE_NORMALIZATION_ENABLED=true인데 OPENAI_API_KEY가 없으면 worker 시작 시 에러가 납니다.
OPENAI_API_KEY=
NOTICE_NORMALIZATION_ENABLED=
NOTICE_NORMALIZATION_MODEL=gpt-5.4-mini
NOTICE_NORMALIZATION_MAX_OUTPUT_TOKENS=4000

# Local-only MSI SSO course catalog collection.
# Copy this file to .env.local and fill real values there. Never commit .env.local.
MJU_CLI_APP_DIR=C:\tmp\mju-sso-collect
MJU_ID=YOUR_STUDENT_ID
MJU_PASSWORD=YOUR_PASSWORD
MJU_CLI_COMMAND=mju
MJU_COURSE_CATALOG_YEAR=2026
MJU_COURSE_CATALOG_TERM_CODE=10
MJU_COURSE_CATALOG_DEPT_CODE=15611
# 여러 학과/교양 카탈로그를 한 번에 공통 DB로 수집할 때 사용합니다.
# 복수 수집에서는 학과코드/과목코드로 전공·교양 분류를 자동 판별합니다.
# 전체 MSI 학과 옵션을 순회하려면 all을 지정하고, 필요하면 seed 코드를 고정합니다.
MJU_COURSE_CATALOG_DEPT_CODES=15611,10000
MJU_COURSE_CATALOG_SEED_DEPT_CODE=10000
MJU_COURSE_CATALOG_CAMPUS_DIV=
MJU_COURSE_CATALOG_CATEGORY=major
MJU_COURSE_CATALOG_CATEGORY_LABEL=전공
MJU_COURSE_CATALOG_TERM_LABEL=1학기
MJU_COURSE_CATALOG_INPUT=C:\tmp\mju-course-catalog.json
MJU_COURSE_CATALOG_OUTPUT=C:\tmp\mju-course-catalog-15611.json
# Official MSI source for department offered-course catalog.
# npm run collect:course-catalog:msi-department-timetable
# npm run export:course-catalog:msi-department-timetable
#
# Optional first SSO smoke source. This imports the authenticated student's MSI timetable
# into the catalog table to validate end-to-end collection/storage before the full
# offered-course catalog menu is wired.
# npm run collect:course-catalog:msi-timetable
#
# Official-source graduation requirement JSON import examples:
# npm run collect:graduation-requirements -- --input C:\tmp\graduation-requirement.json
# npm run collect:graduation-requirements -- --input-dir C:\tmp\graduation-requirements
