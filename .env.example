PGHOST=localhost
PGPORT=5432
PGDATABASE=mjuclaw
PGUSER=mjuclaw_app
PGPASSWORD=change-me
PGSCHEMA=public_data
STORAGE_PROVIDER=local
# Windows 예시: C:\Users\your-name\Desktop\mjuclaw-data\assets
STORAGE_LOCAL_ROOT=/absolute/path/to/mjuclaw-data/assets
OCR_LANGUAGES=kor+eng
# Cafeteria OCR defaults to PaddleOCR. The Docker image includes these deps.
CAFETERIA_OCR_COMMAND=python scripts/cafeteria_paddleocr_candidate.py {image}
PADDLE_OCR_REC_MODEL_NAME=korean_PP-OCRv5_mobile_rec
# Docker scheduler loop options.
# PUBLIC_DATA_WORKER_TICK_INTERVAL_SECONDS=600
# PUBLIC_DATA_WORKER_RUN_MIGRATIONS=1
